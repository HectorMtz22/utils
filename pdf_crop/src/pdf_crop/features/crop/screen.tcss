/* Two-pane crop screen. Left = controls (sections), right = page preview. */

#crop_body {
    height: 1fr;
}

#controls {
    width: 1fr;
    padding: 0 1;
}

/* Each left-pane group: a titled border with breathing room. */
.section {
    border: round $primary;
    border-title-color: $accent;
    border-title-style: bold;
    padding: 0 1;
    margin-bottom: 1;
    height: auto;
}

#pages_hint {
    color: $text-muted;
}

.found-summary {
    color: $text-muted;
}

/* Right pane: the framed preview. Its width is *pinned at runtime* by
 * `PagePreview._pin_pane_to_fit` so the frame hugs the Fit-sized page (replacing
 * the old fixed 60/40 split): the pane is as wide as the contained page plus its
 * border+padding, and #controls (now `width: 1fr`) takes the rest. The width is
 * recomputed in Fit and held constant when toggling to 100%, so a native-size
 * page scrolls *inside* the pane rather than reflowing the whole screen. The
 * starting width below only applies until the first page renders.
 * The nav row and message line are *docked* (top/bottom) so the scroll
 * container holding the image is the pane's only in-flow child and gets the
 * whole band between them. */
#preview {
    width: 50%;
    border: round $primary;
    border-title-color: $accent;
    border-title-style: bold;
    padding: 0 1;
}

#preview_nav {
    dock: top;
    height: auto;
    align: center middle;
}

#preview_status {
    width: 1fr;
    content-align: center middle;
    text-align: center;
}

/* Scroll container holding the image. Fills the band between the docked nav and
 * message rows (`1fr` both axes) and scrolls both ways so a page larger than the
 * pane — every page in 100%, a tall page even in Fit — can be panned with the
 * arrows / wheel / scrollbars instead of being clipped. */
#preview_scroll {
    width: 1fr;
    height: 1fr;
}

/* Fit mode (the default): the rendered page is *contained* within the pane
 * preserving its real proportions: `width: auto` + `height: auto` lets
 * textual-image fit the source to whichever dimension binds first — tall pages
 * fill the height (horizontal slack), wide/Letter pages fill the width (vertical
 * slack). Pinning *both* dimensions to cells distorts the page — textual-image
 * clamps the width but doesn't scale the height back down — so the #36/#38 fix
 * keeps both `auto` here. In 100% mode `_apply_mode_sizing` overrides these with
 * explicit native cell dims (1 image pixel ~= 1 terminal pixel); that's the only
 * place a dimension is pinned, and it's pinned to the *native* size so there's
 * no distortion, just overflow that the scroll container pans over. */
#preview_image {
    width: auto;
    height: auto;
}

/* Loading / "Preview unavailable" line under the image. */
#preview_message {
    dock: bottom;
    height: auto;
    content-align: center middle;
    text-align: center;
    color: $text-muted;
}

/* Action bar + result/error lines. Kept in normal flow (NOT dock: bottom): it
 * sits between the 1fr #crop_body and the bottom-docked Footer, so the two-pane
 * body fills all the space from the Header to here. A second dock: bottom widget
 * would collide with the Footer's row and clip the 3-row Buttons' bottom edge. */
#action_bar {
    height: auto;
    padding: 0 1;
}

#action_bar Static {
    height: auto;
}

#action_buttons {
    height: auto;
    align: left middle;
}

#action_bar Button {
    margin-right: 2;
}

/* Compact buttons (UTILS-16): every button on this screen — the nav
 * (< prev / next >), the left-pane Scan / List metadata, and the action bar
 * (Crop / Cancel / Fit) — renders as a single row of text instead of the
 * default 3-row bordered box, for one consistent compact style across the
 * screen (no row crams or wraps). `border: none` drops the box outline (Crop's
 * primary highlight is a *background*, so it survives); height/min-height pin
 * the single row; the tight horizontal padding trims the wide default gutter. */
Button {
    height: 1;
    min-height: 1;
    border: none;
    padding: 0 1;
}

/* Help overlay. */
HelpScreen {
    align: center middle;
}

#help_panel {
    width: 60;
    height: auto;
    border: round $accent;
    border-title-color: $accent;
    padding: 1 2;
    background: $panel;
}
