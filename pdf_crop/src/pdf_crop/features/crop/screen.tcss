/* Two-pane crop screen. Left = controls (sections), right = page preview. */

#crop_body {
    height: 1fr;
}

#controls {
    width: 40%;
    padding: 0 1;
}

/* Each left-pane group: a titled border with breathing room. */
.section {
    border: round $primary;
    border-title-color: $accent;
    border-title-style: bold;
    padding: 0 1;
    margin-bottom: 1;
    height: auto;
}

#pages_hint {
    color: $text-muted;
}

.found-summary {
    color: $text-muted;
}

/* Right pane: the framed preview. The nav row and message line are *docked*
 * (top/bottom) so the page image is the pane's only in-flow child. That lets
 * `align-horizontal: right` shift just the image flush against the pane's right
 * edge: Textual's vertical layout has no per-child cross-axis alignment, and a
 * container's `align` translates *all* in-flow children together — so with the
 * full-width nav/message in flow the image can't be pushed right on its own.
 * Docking them out of flow leaves the (narrower-than-pane) image free to align
 * right while the rows stay pinned to the top and bottom edges. */
#preview {
    width: 60%;
    border: round $primary;
    border-title-color: $accent;
    border-title-style: bold;
    padding: 0 1;
    align-horizontal: right;
}

#preview_nav {
    dock: top;
    height: auto;
    align: center middle;
}

#preview_status {
    width: 1fr;
    content-align: center middle;
    text-align: center;
}

/* The rendered page is *contained* within the pane preserving its real
 * proportions: `width: auto` + `height: auto` lets textual-image fit the source
 * to whichever pane dimension binds first — tall pages fill the height (leaving
 * horizontal slack), wide/Letter pages fill the width (leaving vertical slack).
 * This is "fit within the pane", NOT a guaranteed full-height; a wide page is
 * shorter than the pane and that's correct. Pinning *both* dimensions (e.g.
 * `height: 1fr` with `width: auto`) is what distorts the page — textual-image
 * clamps the width to the pane but doesn't scale the height back down, so
 * anything wider than the pane's cell ratio gets stretched to the full box.
 * Keeping both `auto` is the UTILS-11/#36 fix; never pin either dimension.
 * Docking the nav and message (above/below) makes this image the pane's only
 * in-flow child, so `align-horizontal: right` on #preview can push it flush
 * against the pane's right edge on its own. */
#preview_image {
    width: auto;
    height: auto;
}

/* Loading / "Preview unavailable" line under the image. */
#preview_message {
    dock: bottom;
    height: auto;
    content-align: center middle;
    text-align: center;
    color: $text-muted;
}

/* Bottom action bar + result/error lines. */
#action_bar {
    dock: bottom;
    height: auto;
    padding: 0 1;
}

#action_bar Static {
    height: auto;
}

#action_buttons {
    height: auto;
    align: left middle;
}

#action_bar Button {
    margin-right: 2;
}

/* Help overlay. */
HelpScreen {
    align: center middle;
}

#help_panel {
    width: 60;
    height: auto;
    border: round $accent;
    border-title-color: $accent;
    padding: 1 2;
    background: $panel;
}
